<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>The Executive Advantage Score | Adrian Evans</title>
<style>
  :root{
    --navy:#29245c;
    --orange:#e9761b;
    --navy-light:#3a3478;
    --navy-pale:#f0effa;
    --orange-pale:#fef4e8;
    --border:#d9d6ee;
    --muted:#6b6888;
    --ink:#1a1833;
  }
  *{box-sizing:border-box;}
  body{
    margin:0;
    font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;
    background:#f7f7fb;
    color:var(--ink);
  }
  header{
    background:var(--navy);
    padding:16px 32px;
    display:flex;
    align-items:center;
    justify-content:flex-end;
  }
  header img{
    height:141px;
    width:auto;
    display:block;
    object-fit:contain;
  }
  #app{max-width:640px;margin:0 auto;padding:40px 24px 80px;}
  .eyebrow{font-size:13px;color:var(--orange);letter-spacing:.06em;margin:0 0 8px;text-transform:uppercase;font-weight:600;}
  h1{font-size:28px;font-weight:700;margin:0 0 14px;line-height:1.25;color:var(--navy);}
  h2{font-size:19px;font-weight:700;margin:0 0 20px;color:var(--navy);}
  p{font-size:15px;line-height:1.7;color:var(--muted);margin:0 0 16px;}
  .progress{height:5px;background:var(--border);border-radius:4px;margin-bottom:32px;overflow:hidden;}
  .progress-fill{height:5px;background:var(--orange);transition:width .25s;}
  .stage-label{font-size:13px;color:var(--orange);font-weight:600;margin:0 0 4px;text-transform:uppercase;letter-spacing:.04em;}
  .item{margin-bottom:24px;}
  .item-row{display:flex;justify-content:space-between;align-items:baseline;margin-bottom:8px;gap:16px;}
  .item-label{font-size:14.5px;line-height:1.5;color:var(--ink);}
  .item-score{
    font-size:15px;font-weight:700;min-width:36px;text-align:center;
    background:var(--navy);color:#fff;border-radius:6px;padding:2px 6px;
  }
  input[type=range]{width:100%;accent-color:var(--orange);cursor:pointer;}
  .scale-labels{display:flex;justify-content:space-between;font-size:11px;color:var(--muted);margin-top:3px;}
  input[type=email],input[type=text]{
    width:100%;max-width:340px;padding:11px 14px;
    border:1.5px solid var(--border);border-radius:8px;
    font-size:15px;margin-bottom:10px;font-family:inherit;
    outline:none;
  }
  input[type=email]:focus,input[type=text]:focus{border-color:var(--orange);}
  .btn{
    border:none;padding:11px 24px;border-radius:8px;font-size:14.5px;font-weight:700;
    cursor:pointer;font-family:inherit;transition:opacity .15s;
  }
  .btn:hover{opacity:.88;}
  .btn-primary{background:var(--orange);color:#fff;}
  .btn-secondary{background:none;border:1.5px solid var(--border);color:var(--ink);}
  .btn-row{display:flex;justify-content:space-between;margin-top:16px;}
  .instruction{
    font-size:13px;color:var(--muted);margin:-8px 0 20px;
    padding:10px 14px;background:var(--navy-pale);border-left:4px solid var(--orange);
    border-radius:0 8px 8px 0;line-height:1.6;
  }
  .instruction strong{color:var(--navy);}
  .score-total{text-align:center;margin-bottom:28px;}
  .score-num{font-size:52px;font-weight:800;color:var(--navy);}
  .score-max{font-size:20px;color:var(--muted);font-weight:400;}
  .band-pill{
    display:inline-block;margin-top:10px;padding:7px 20px;border-radius:20px;
    background:var(--orange);color:#fff;font-size:13px;font-weight:700;letter-spacing:.03em;
  }
  .stage-bar-wrap{margin-bottom:12px;}
  .stage-bar-row{display:flex;justify-content:space-between;font-size:13px;margin-bottom:5px;color:var(--ink);}
  .stage-bar-bg{height:9px;border-radius:4px;background:var(--border);overflow:hidden;}
  .stage-bar-fill{height:9px;border-radius:4px;background:var(--orange);}
  .focus-box{background:var(--navy-pale);border-radius:12px;padding:18px 20px;margin:24px 0;border:1.5px solid var(--border);}
  .focus-title{font-size:12px;font-weight:800;margin:0 0 12px;text-transform:uppercase;letter-spacing:.06em;color:var(--navy);}
  .focus-item{display:flex;justify-content:space-between;align-items:center;gap:16px;font-size:14px;padding:7px 0;border-bottom:1px solid var(--border);color:var(--muted);}
  .focus-item:last-child{border-bottom:none;}
  .focus-item span:first-child{flex:1;}
  .focus-score{font-weight:700;color:var(--orange);white-space:nowrap;flex-shrink:0;min-width:44px;text-align:right;}
  .footer-note{font-size:13px;color:var(--muted);text-align:center;border-top:1.5px solid var(--border);padding-top:18px;margin-top:24px;}
  .err{color:#c0392b;font-size:13px;margin:-4px 0 12px;}
  .divider{height:1.5px;background:var(--border);margin:28px 0;}

  /* =====================
     MOBILE RESPONSIVE
     ===================== */
  @media (max-width: 600px) {

    /* Global layout */
    #app {
      padding: 24px 18px 60px;
    }

    header {
      padding: 14px 18px;
    }

    header img {
      height: 56px;
    }

    /* Typography */
    h1 {
      font-size: 22px;
      line-height: 1.3;
    }

    h2 {
      font-size: 17px;
    }

    p {
      font-size: 14px;
    }

    .eyebrow {
      font-size: 11px;
    }

    /* Buttons — full width on mobile */
    .btn {
      width: 100%;
      text-align: center;
      padding: 13px 16px;
      font-size: 15px;
    }

    .btn-row {
      flex-direction: column-reverse;
      gap: 10px;
    }

    /* Inputs — full width */
    input[type=email],
    input[type=text] {
      max-width: 100%;
      font-size: 16px; /* prevents iOS zoom on focus */
      padding: 13px 14px;
    }

    /* Slider items */
    .item {
      margin-bottom: 28px;
    }

    .item-row {
      flex-wrap: nowrap;
      gap: 10px;
    }

    .item-label {
      font-size: 14px;
    }

    .item-score {
      font-size: 14px;
      min-width: 40px;
    }

    /* Instruction box */
    .instruction {
      font-size: 13px;
      padding: 10px 12px;
    }

    /* Stage label */
    .stage-label {
      font-size: 12px;
    }

    /* Results — score total */
    .score-num {
      font-size: 42px;
    }

    .score-max {
      font-size: 16px;
    }

    .band-pill {
      font-size: 12px;
      padding: 6px 14px;
    }

    /* Stage bars */
    .stage-bar-row {
      font-size: 13px;
    }

    /* Results — expanded step rows */
    .stage-bar-wrap > div[style*="border"] div[style*="display:flex"] {
      flex-wrap: wrap;
      gap: 6px;
    }

    /* Focus box */
    .focus-box {
      padding: 14px 14px;
    }

    .focus-title {
      font-size: 11px;
    }

    .focus-item {
      font-size: 13px;
      gap: 10px;
    }

    .focus-score {
      min-width: 40px;
    }

    /* Divider */
    .divider {
      margin: 20px 0;
    }

    /* Footer note */
    .footer-note {
      font-size: 13px;
    }
  }

</style>
</head>
<body>

<header>
  <img src="data:image/png;base64," alt="Payments Leaders Advisory">
</header>

<div id="app"></div>

<script>
const WEBHOOK_URL = "https://hooks.zapier.com/hooks/catch/28101135/42vbqmk/";

const sectionDescs = {
  "The Foundation": "Assess your career direction, mindset and commitment that form the basis of your career story.",
  "Go to Market": "Evaluate how effectively you position yourself to employers, recruiters, and visibility with key industry contacts.",
  "The Methodology": "Measure how often you connect with powerful and valuable decision makers who can influence your career.",
  "Platform to Shine": "Review your interview approach, and ability to identify pressing challenges for future employers, that enable you to stand out in your industry.",
  "Close and Win": "Assess your ability to build trust with this process and secure appropriate reward in your next executive role."
};

const sections = [
  { name:"The Foundation", items:[
    {key:"clarity", weight:2, label:"I have clear, written-down career goals."},
    {key:"open", weight:1, label:"I am open in approach and will explore a number of different career ideas."},
    {key:"committed", weight:1, label:"I am committed to change \u2013 to think and do differently than previously."},
    {key:"adapt", weight:1, label:"I can learn and refine my career target as I go."},
    {key:"criteria", weight:1, label:"I have established criteria to measure job opportunities by."},
    {key:"mindset", weight:2, label:"I have a daily mind-set that is resourceful, action-orientated and positive towards achieving my next executive role."}
  ]},
  { name:"Go to Market", items:[
    {key:"profile", weight:1, label:"My CV and LinkedIn profile are achievement-led."},
    {key:"position", weight:1, label:"I have positioned myself effectively and confidently, and know what my brand stands for."}
  ]},
  { name:"The Methodology", items:[
    {key:"calls", weight:3, label:"I have made my first job outreach call \u2013 and my twenty-first."},
    {key:"record", weight:1, label:"I have recorded my progress to date."}
  ]},
  { name:"Platform to Shine", items:[
    {key:"solve", weight:2, label:"I have developed plans to solve potential employers' business problems and create 'hidden' opportunities."},
    {key:"approach", weight:1, label:"I have a 'stand out' and engaging interview approach."}
  ]},
  { name:"Close and Win", items:[
    {key:"reward", weight:2, label:"I know my worth and am able to negotiate an appropriate salary/package."},
    {key:"belief", weight:1, label:"I believe in myself, and I believe that by patiently following the process, positive career options will evolve."}
  ]}
];

const bands = [
  {min:0, max:80, label:"Not yet visible", desc:"Foundational gaps are limiting your access to the hidden market."},
  {min:81, max:130, label:"Emerging access", desc:"The foundations are there \u2013 execution is inconsistent."},
  {min:131, max:170, label:"Active access", desc:"You're well positioned. Refine and amplify what's working."},
  {min:171, max:200, label:"Hidden market insider", desc:"You're executing at a high level across all 14 steps."}
];

let values = {};
let step = 0;
let nameVal = "";
let emailVal = "";
const screens = ["intro"].concat(sections.map((s,i)=>"s"+i)).concat(["contact","results"]);
const root = document.getElementById("app");

function maxForSection(s){ return s.items.reduce((a,it)=>a+it.weight*10,0); }

function render(){
  const screen = screens[step];
  if(screen==="intro") return renderIntro();
  if(screen==="contact") return renderContact();
  if(screen==="results") return renderResults();
  renderSection(parseInt(screen.slice(1),10));
}

function progressBar(){
  const pct = Math.round((step/(screens.length-1))*100);
  return `<div class="progress"><div class="progress-fill" style="width:${pct}%"></div></div>`;
}

function renderIntro(){
  root.innerHTML = `
    <p class="eyebrow">The Executive Advantage Score &middot; Adrian Evans</p>
    <h1>Measuring Your Progress to Secure Next Executive Position</h1>
    <p>Payments executives don't struggle to secure their next role because of a lack of talent, they struggle because they lack a process. After decades as a London headhunter, Adrian developed this proven 14-step career framework to support senior leaders create opportunities rather than chase them. This has proved effective even in the most challenging job markets (2008/09) &ndash; hundreds of executives have utilised it to secure their next role, often generating multiple offers and greater career choice.</p>
    <p>Rate yourself honestly across <strong>14 steps in 5 stages</strong> &ndash; about 4 minutes. You'll get a score out of 200 and a clear view of where to focus first.</p>
    <div class="divider"></div>
    <button class="btn btn-primary" id="start-btn" style="width:100%;margin-top:8px;">Start the Diagnostic &rarr;</button>
  `;
  document.getElementById("start-btn").onclick = ()=>{ step++; render(); };
}

function renderSection(idx){
  const s = sections[idx];
  let html = progressBar();
  html += `<p class="stage-label">Stage ${idx+1} of ${sections.length}</p>`;
  html += `<h2>${s.name}</h2>`;
  html += `<p style="font-size:14px;color:var(--muted);line-height:1.6;margin:-8px 0 16px;font-style:italic;">${sectionDescs[s.name]}</p>`;
  html += `<div class="instruction">&#128073; <strong>How to score:</strong> Slide the button to select your answer. <strong>0</strong> means this doesn't apply at all &mdash; <strong>10</strong> means completely true.</div>`;
  s.items.forEach(it=>{
    if(values[it.key]===undefined) values[it.key]=0;
    const v = values[it.key];
    html += `
      <div class="item">
        <div class="item-row">
          <label class="item-label">${it.label}</label>
          <span class="item-score" id="out-${it.key}">${v}</span>
        </div>
        <input type="range" min="0" max="10" step="1" value="${v}" data-key="${it.key}">
        <div class="scale-labels"><span>0 &mdash; Not at all</span><span>10 &mdash; Completely true</span></div>
      </div>`;
  });
  html += `<div class="btn-row">`;
  html += idx===0 ? `<span></span>` : `<button class="btn btn-secondary" id="back-btn">&larr; Back</button>`;
  html += `<button class="btn btn-primary" id="next-btn">${idx===sections.length-1?"Continue &rarr;":"Continue &rarr;"}</button>`;
  html += `</div>`;
  root.innerHTML = html;

  s.items.forEach(it=>{
    root.querySelector(`input[data-key="${it.key}"]`).addEventListener("input", e=>{
      values[it.key] = parseInt(e.target.value,10);
      document.getElementById(`out-${it.key}`).textContent = values[it.key];
    });
  });
  const backBtn = document.getElementById("back-btn");
  if(backBtn) backBtn.onclick = ()=>{ step--; render(); };
  document.getElementById("next-btn").onclick = ()=>{ step++; render(); };
}

function renderContact(){
  let html = progressBar();
  html += `<h2>Almost There</h2>`;
  html += `<p>Enter your details below to reveal your score and full breakdown.</p>`;
  html += `<div class="instruction" style="margin-bottom:16px;">&#9888;&#65039; <strong>Important:</strong> Please use a <strong>personal email address</strong> (e.g. Gmail, Hotmail, Yahoo). Corporate email addresses may block delivery of your results.</div>`;
  html += `<input type="text" id="name-input" placeholder="Full name" value="${nameVal}"><br>`;
  html += `<input type="email" id="email-input" placeholder="your.name@gmail.com" value="${emailVal}">`;
  html += `<div id="contact-err" class="err" style="display:none;">Please enter your full name and a valid personal email address.</div>`;
  html += `<div class="btn-row" style="margin-top:8px;">
    <button class="btn btn-secondary" id="back-btn">&larr; Back</button>
    <button class="btn btn-primary" id="reveal-btn">Reveal My Score &rarr;</button>
  </div>`;
  root.innerHTML = html;
  document.getElementById("back-btn").onclick = ()=>{ step--; render(); };
  document.getElementById("reveal-btn").onclick = ()=>{
    nameVal = document.getElementById("name-input").value.trim();
    emailVal = document.getElementById("email-input").value.trim();
    if(!nameVal || !emailVal || !emailVal.includes("@")){
      document.getElementById("contact-err").style.display="block";
      return;
    }
    step++; render();
  };
}

function renderResults(){
  let total = 0;
  const allItems = [];
  const sectionScores = sections.map(s=>{
    const sc = s.items.reduce((a,it)=>a+(values[it.key]||0)*it.weight,0);
    total += sc;
    s.items.forEach(it=> allItems.push({label:it.label, raw:values[it.key]||0}));
    return {name:s.name, score:sc, max:maxForSection(s), items:s.items};
  });
  const band = bands.find(b=>total>=b.min && total<=b.max) || bands[0];
  const focus = allItems.slice().sort((a,b)=>a.raw-b.raw).slice(0,3);

  let html = `
    <div class="score-total">
      <p class="eyebrow">The Executive Advantage Score</p>
      <div><span class="score-num">${total}</span><span class="score-max"> / 200</span></div>
      <div class="band-pill">${band.label}</div>
      <p style="max-width:420px;margin:12px auto 0;">${band.desc}</p>
    </div>
    <div class="divider"></div>`;

  sectionScores.forEach(s=>{
    const pct = Math.round((s.score/s.max)*100);
    html += `
      <div class="stage-bar-wrap" style="margin-bottom:20px;">
        <div class="stage-bar-row"><span style="font-weight:700;">${s.name}</span></div>
        <div class="stage-bar-bg" style="margin-bottom:8px;"><div class="stage-bar-fill" style="width:${pct}%"></div></div>
        <p style="font-size:13px;color:var(--muted);margin:4px 0 10px;line-height:1.5;">${sectionDescs[s.name]}</p>
        <div style="border:1px solid var(--border);border-radius:8px;overflow:hidden;">`;
    s.items.forEach((it,i)=>{
      const raw = values[it.key]||0;
      const ipct = Math.round((raw/10)*100);
      const bg = i%2===0 ? "background:var(--navy-pale);" : "";
      html += `
          <div style="display:flex;align-items:center;gap:12px;padding:9px 14px;${bg}border-bottom:${i<s.items.length-1?"1px solid var(--border)":"none"};">
            <div style="flex:1;font-size:13px;color:var(--ink);line-height:1.4;min-width:0;word-break:break-word;">${it.label}</div>
            <div style="width:80px;flex-shrink:0;">
              <div style="height:6px;border-radius:3px;background:var(--border);overflow:hidden;">
                <div style="height:6px;width:${ipct}%;background:var(--orange);border-radius:3px;"></div>
              </div>
            </div>
            <div style="font-size:13px;font-weight:700;color:var(--navy);min-width:44px;text-align:right;white-space:nowrap;">${raw} / 10</div>
          </div>`;
    });
    html += `</div>
        <div style="display:flex;justify-content:flex-end;align-items:center;padding:10px 14px;background:var(--navy-pale);border-top:1.5px solid var(--border);border-radius:0 0 8px 8px;">
          <span style="font-size:12px;color:var(--muted);margin-right:10px;text-transform:uppercase;letter-spacing:.04em;font-weight:600;">Stage total</span>
          <span style="font-size:15px;font-weight:800;color:var(--navy);">${s.score} / ${s.max}</span>
        </div>
      </div>
      <div style="height:24px;"></div>`;
  });

  html += `<div class="focus-box">
    <p class="focus-title">&#9660; Key Focus Areas</p>`;
  focus.forEach(f=>{
    html += `<div class="focus-item"><span>${f.label}</span><span class="focus-score">${f.raw} / 10</span></div>`;
  });
  html += `</div>`;

  html += `<div class="footer-note">
    <p id="submit-status">Sending your result to Adrian...</p>
    <button class="btn btn-secondary" id="retake-btn" style="margin-top:10px;width:100%;">Retake the Diagnostic</button>
  </div>`;

  root.innerHTML = html;
  document.getElementById("retake-btn").onclick = ()=>{ step=0; values={}; render(); };
  submitResult({name:nameVal, email:emailVal, total, band:band.label, sectionScores, focus});
}

async function submitResult(payload){
  const statusEl = document.getElementById("submit-status");
  if(!WEBHOOK_URL){
    if(statusEl) statusEl.textContent = "Adrian will follow up to walk through your weakest stage.";
    return;
  }
  try{
    await fetch(WEBHOOK_URL,{
      method:"POST", mode:"no-cors",
      headers:{"Content-Type":"application/json"},
      body: JSON.stringify({
        timestamp: new Date().toISOString(),
        name: payload.name,
        email: payload.email,
        total_score: payload.total,
        band: payload.band,
        foundation_score: payload.sectionScores[0].score,
        go_to_market_score: payload.sectionScores[1].score,
        methodology_score: payload.sectionScores[2].score,
        platform_to_shine_score: payload.sectionScores[3].score,
        close_and_win_score: payload.sectionScores[4].score,
        lowest_step_1: payload.focus[0]?.label || "",
        lowest_step_2: payload.focus[1]?.label || "",
        lowest_step_3: payload.focus[2]?.label || ""
      })
    });
    if(statusEl) statusEl.textContent = "Result sent to Adrian. He'll follow up to walk through your weakest stage.";
  }catch(err){
    if(statusEl) statusEl.textContent = "Adrian will follow up to walk through your weakest stage.";
  }
}

render();
</script>
</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>The Executive Advantage</title>
<style>
  :root {
    --navy: #29245c;
    --orange: #e9761b;
    --navy-light: #3a3478;
    --navy-pale: #f0effa;
    --orange-pale: #fef4e8;
    --border: #d9d6ee;
    --muted: #6b6888;
    --ink: #1a1833;
    --white: #ffffff;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  html { scroll-behavior: smooth; }
  body {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    color: var(--ink);
    background: var(--white);
  }

  /* ── NAV ── */
  nav {
    position: sticky; top: 0; z-index: 100;
    background: var(--navy);
    display: flex; align-items: center; justify-content: space-between;
    padding: 0 40px; height: 72px;
    box-shadow: 0 2px 12px rgba(0,0,0,.25);
  }
  .nav-brand {
    display: flex; align-items: center; gap: 14px; text-decoration: none;
  }
  .nav-brand span {
    color: var(--white); font-size: 15px; font-weight: 700;
    letter-spacing: .04em; text-transform: uppercase; line-height: 1.2;
  }
  .nav-brand span em {
    display: block; color: var(--orange); font-style: normal; font-size: 11px; font-weight: 600; letter-spacing: .08em;
  }
  .nav-links { display: flex; align-items: center; gap: 6px; }
  .nav-links a {
    color: rgba(255,255,255,.8); text-decoration: none;
    font-size: 13px; font-weight: 500; padding: 8px 14px; border-radius: 6px;
    transition: all .15s;
  }
  .nav-links a:hover, .nav-links a.active { color: var(--white); background: rgba(255,255,255,.1); }
  .nav-links .nav-cta {
    background: var(--orange); color: var(--white) !important;
    padding: 8px 18px; border-radius: 6px; margin-left: 8px; font-weight: 700;
  }
  .nav-links .nav-cta:hover { background: #d4660f; }
  .nav-hamburger { display: none; flex-direction: column; gap: 5px; cursor: pointer; padding: 8px; }
  .nav-hamburger span { display: block; width: 22px; height: 2px; background: var(--white); border-radius: 2px; transition: .2s; }
  .mobile-menu {
    display: none; position: fixed; top: 72px; left: 0; right: 0; z-index: 99;
    background: var(--navy); padding: 16px 24px; flex-direction: column; gap: 4px;
